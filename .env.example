# 数据库连接（推荐默认：MySQL 持久化）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/tomato_diagnosis?charset=utf8mb4

# 持久化存储模式（默认推荐全部走 MySQL；仍可按需改为 file / dual / mysql）
PROFILE_STORE_MODE=mysql
EVENT_STORE_MODE=mysql
TRACE_STORE_MODE=mysql
KB_STORE_MODE=mysql

# Demo 账号开关（默认关闭；关闭时不会在重启后自动回灌 A0001/E0001/E0002）
ENABLE_DEMO_ACCOUNTS=false

# 大模型提供方配置（二选一或按需填写）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

WENXIN_API_KEY=
WENXIN_SECRET_KEY=
WENXIN_MODEL=ernie-bot-turbo

# 诊断模型配置
DIAGNOSIS_MODEL_TYPE=densenet121
DIAGNOSIS_BACKEND=tf
DIAGNOSIS_MODEL_PATH=
USE_GPU=false
